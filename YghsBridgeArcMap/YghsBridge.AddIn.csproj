<Project Sdk="Microsoft.NET.Sdk">

  <!-- yghsBridge：ArcMap 10.4-10.8 add-in，无 Visual Studio 构建。
       net45 (CLR4.5, ArcMap 加载的目标) + x86 (ArcMap 是 32 位)。
       ESRI 程序集从 GAC/bin 引用且 Private=False（运行时由 ArcMap 提供，不进包）。 -->
  <PropertyGroup>
    <TargetFramework>net45</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>YghsBridge.AddIn</RootNamespace>
    <AssemblyName>YghsBridge.AddIn</AssemblyName>
    <!-- 程序集版本与 Config.xml 的 Version 保持一致（ping 返回的是这个） -->
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Newtonsoft.Json.dll 必须落到 bin\ 以便打进 Install\ -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- 出进程的 arcpy runner 内嵌在 DLL 里（每次调用解到 %TEMP%）：包依然自包含 -->
  <ItemGroup>
    <EmbeddedResource Include="Python\runner.py" />
  </ItemGroup>

  <!-- Framework: WindowsBase 提供 System.Windows.Threading.Dispatcher (WPF) -->
  <ItemGroup>
    <Reference Include="WindowsBase" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ESRI.ArcGIS.Desktop.AddIns">
      <HintPath>D:\Work\ArcGIS\Desktop10.8\bin\ESRI.ArcGIS.Desktop.AddIns.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ESRI.ArcGIS.System">
      <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_MSIL\ESRI.ArcGIS.System\v4.0_10.8.0.0__8fc3cc631e44ad86\ESRI.ArcGIS.System.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ESRI.ArcGIS.Framework">
      <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_MSIL\ESRI.ArcGIS.Framework\v4.0_10.8.0.0__8fc3cc631e44ad86\ESRI.ArcGIS.Framework.dll</HintPath>
